{
  "name": "marked-obsidian",
  "version": "0.1.0",
  "description": "A marked plugin for Obsidian-flavored markdown syntax",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "marked",
    "obsidian",
    "markdown",
    "plugin",
    "wikilinks",
    "callouts",
    "highlight",
    "obsidian-md"
  ],
  "author": {
    "name": "wvanderp",
    "url": "https://github.com/wvanderp"
  },
  "license": "MIT",
  "homepage": "https://github.com/wvanderp/marked-obsidian#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wvanderp/marked-obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/wvanderp/marked-obsidian/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "lint": "npm run lint:eslint && npm run typecheck",
    "lint:eslint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "marked": ">=14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "fast-xml-parser": "^5.7.1",
    "globals": "^17.5.0",
    "html-to-json-parser": "^2.0.1",
    "jiti": "^2.6.1",
    "ts-node": "^10.9.2",
    "tsdown": "^0.21.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
