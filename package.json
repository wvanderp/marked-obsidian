{
  "name": "marked-obsidian",
  "version": "1.0.0",
  "description": "A obsidian plugin for the marked markdown parser",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "lint": "npm run lint:eslint && npm run typecheck",
    "lint:eslint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "marked": "^18.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "fast-xml-parser": "^5.7.1",
    "globals": "^17.5.0",
    "html-to-json-parser": "^2.0.1",
    "jiti": "^2.6.1",
    "ts-node": "^10.9.2",
    "tsdown": "^0.21.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
